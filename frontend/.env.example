# CodeAtlas frontend environment template.
# Copy to .env.local and adjust:  Copy-Item .env.example .env.local

# Base URL of the CodeAtlas backend API.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Request timeout in milliseconds. Indexing and scanning large
# repositories can take a while, so keep this generous.
VITE_API_TIMEOUT_MS=120000
