# CodeAtlas environment template.
# Copy to .env and adjust values:  Copy-Item .env.example .env
# .env is gitignored; never commit real secrets.
# Every variable except GEMINI_API_KEY has a working local default.

# --- Application (read by the FastAPI backend, prefix CODEATLAS_) ---
# Debug flag and root logging level (DEBUG, INFO, WARNING, ...).
CODEATLAS_DEBUG=false
CODEATLAS_LOG_LEVEL=INFO
# Allowed CORS origins (JSON list). Defaults cover the Vite dev server.
# CODEATLAS_CORS_ORIGINS=["http://localhost:5173"]

# --- Gemini (required for /index and /ask) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# --- PostgreSQL (read by docker-compose and the backend) ---
# Credentials and database created on the container's first start.
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=codeatlas_dev_password
POSTGRES_DB=codeatlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Qdrant (read by docker-compose and the backend) ---
# HTTP port serves the REST API and the dashboard (/dashboard).
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
