# Normalize line endings so the repo is consistent across platforms.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Keep generated lockfiles out of diffs and language stats.
package-lock.json linguist-generated=true -diff
docs/project_structure.md linguist-generated=true
